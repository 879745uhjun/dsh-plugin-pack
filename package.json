{
  "name": "dsh-plugin-pack",
  "version": "0.1.0",
  "description": "Bundle a set of DSH plugins, their configs and version locks into one portable .dshpack, then install it on another machine.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-pack": "./bin/dsh-pack.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/*.mjs",
    "lib/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugins",
    "bundle",
    "pack",
    "migration"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "author": "879745uhjun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-plugin-pack.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-plugin-pack#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-plugin-pack/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
